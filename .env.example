# Copy of the variable NAMES the app needs. Real values live in Vercel:
#   vercel env pull .env.local

# Neon Postgres (set by the Vercel Marketplace integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Resend (set by the Vercel Marketplace integration)
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=

# Better Auth: a different random value per environment
BETTER_AUTH_SECRET=

# Optional. Preview deployments only email this address; without it they send nothing.
EMAIL_OVERRIDE_TO=
# Optional. A monitored inbox for replies.
EMAIL_REPLY_TO=

# Gift cards. Leave unset to keep them switched off.
# A restricted key from the Algorythmos platform account.
STRIPE_SECRET_KEY=
# The restaurant's connected account (acct_...). Charges are made on it directly.
STRIPE_CONNECT_ACCOUNT_ID=
# Signing secret of the Connect webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Optional. The platform's share in basis points, 0 to 1000. Unset means none.
GIFT_PLATFORM_FEE_BPS=
# 64 hex characters: openssl rand -hex 32. Never change it once cards exist.
GIFT_CODE_KEY=
# Production only, and only with live Stripe keys.
GIFT_CARDS_LIVE=
# Optional extra website origins allowed to call the gift card API, comma separated.
GIFT_SITE_ORIGINS=

# Scheduled jobs (nightly backup, email retries). Vercel sends it to /api/cron/*;
# without it every run is refused with a 401 and backups stop.
CRON_SECRET
# Private Blob store for the nightly backups (set by connecting the Blob store).
BLOB_READ_WRITE_TOKEN
# Optional. An inbox that gets problems needing a person (failed backup, unmatched payment, card on hold).
ALERT_EMAIL
